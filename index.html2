<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Nos Localisations</title>
  <style>
    body {
      background-color: #f5f5f5;
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .container {
      background: white;
      border: 1px solid #ccc;
      padding: 30px 50px;
      text-align: center;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      border-radius: 8px;
    }

    .container h1 {
      margin-bottom: 20px;
    }

    .link {
      display: block;
      margin: 10px 0;
      color: #007bff;
      text-decoration: none;
      font-size: 18px;
    }

    .link:hover {
      text-decoration: underline;
    }

    .section {
      margin-top: 20px;
    }

  </style>
</head>
<body>
  <div class="container">
    <h1>Nos Localisations</h1>
    
    <!-- Section pour Localisation 1 -->
    <div class="section">
      <h2>Localisation 1</h2>
      <a href="#localisation1" class="link">Voir les détails</a>
      <div id="localisation1" class="details" style="display:none;">
        <p>Détails de la localisation 1.</p>
      </div>
    </div>
    
    <!-- Section pour Localisation 2 -->
    <div class="section">
      <h2>Localisation 2</h2>
      <a href="#localisation2" class="link">Voir les détails</a>
      <div id="localisation2" class="details" style="display:none;">
        <p>Détails de la localisation 2.</p>
      </div>
    </div>

    <!-- Section pour Localisation 3 -->
    <div class="section">
      <h2>Localisation 3</h2>
      <a href="#localisation3" class="link">Voir les détails</a>
      <div id="localisation3" class="details" style="display:none;">
        <p>Détails de la localisation 3.</p>
      </div>
    </div>
    
  </div>

  <script>
    // Code pour afficher/masquer les détails
    const links = document.querySelectorAll('.link');
    links.forEach(link => {
      link.addEventListener('click', function(event) {
        event.preventDefault();
        const targetId = this.getAttribute('href').substring(1); // On enlève le '#'
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          targetElement.style.display = targetElement.style.display === 'none' ? 'block' : 'none';
        }
      });
    });
  </script>

</body>
</html>
